# Copy this file to .env.local and replace every placeholder.
# Never commit .env.local or real keys.

# --- Public (safe to expose to the browser) ---
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_TURNSTILE_SITE_KEY=your-turnstile-site-key

# --- Server-only (never import these into client components) ---
RESEND_API_KEY=re_your-resend-api-key
# Use a placeholder here. Put the real sender only in .env.local and the host’s env vars.
# Testing: Resend’s sandbox sender only delivers to the email on your Resend account.
# Production: verify your domain, then use a from-address on that domain.
RESEND_FROM_EMAIL=Earthline Contracting <your-verified-sender@example.com>
TURNSTILE_SECRET_KEY=your-turnstile-secret-key
QUOTE_INBOX_EMAIL=quotes@example.com

# Google Drive gallery sync (build time only; never expose to the browser)
# Paste the full service-account JSON as one line. Leave blank until Drive is set up.
GOOGLE_SERVICE_ACCOUNT_JSON=
GOOGLE_DRIVE_GALLERY_FOLDER_ID=
